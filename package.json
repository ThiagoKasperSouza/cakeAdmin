{
  "name": "cake-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron:dev": "ELECTRON_START_URL=http://localhost:4200 electron .",
    "electron:start": "ng build && electron .",
    "electron:dist": "ng build && electron-builder --dir"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "main": "electron/main.cjs",
  "description": "Delizia CakeAdmin — painel interno de gestão de confeitaria (desktop interno)",
  "build": {
    "appId": "com.delizia.cakeadmin",
    "productName": "Delizia CakeAdmin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/cakeAdmin/browser/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Office",
      "executableName": "delizia-cakeadmin"
    },
    "win": {
      "target": "portable",
      "artifactName": "Delizia-CakeAdmin-Setup.${ext}"
    }
  },
  "author": "Delizia Confeitaria Artesanal"
}
